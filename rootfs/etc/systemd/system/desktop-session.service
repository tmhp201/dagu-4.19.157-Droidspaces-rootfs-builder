[Unit]
Description=KDE Plasma session on the Termux:X11 display
After=dbus.service systemd-networkd.service
Wants=dbus.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=1000
Environment=XDG_SESSION_TYPE=x11
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SESSION_DESKTOP=KDE
Environment=XDG_CURRENT_DESKTOP=KDE
Environment=XDG_RUNTIME_DIR=/run/user/1000
EnvironmentFile=-/etc/environment
EnvironmentFile=-/run/droidspaces.env
Environment=DISPLAY=:5
ExecStart=/usr/local/bin/start-desktop-session
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
