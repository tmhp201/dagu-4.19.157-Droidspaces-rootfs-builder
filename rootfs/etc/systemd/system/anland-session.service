[Unit]
Description=Anland session (wayland socket, rootless Xwayland, mini window manager)
After=dbus.service
Wants=dbus.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=1000
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=ANLAND_RUNTIME_DIR=/run/anland
EnvironmentFile=-/etc/environment
EnvironmentFile=-/run/droidspaces.env
ExecStart=/usr/local/bin/start-anland-session
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
