#!/bin/sh
# 把宿主挂进 /mnt/termux 的 Termux:X11 socket 目录桥到 /tmp/.X11-unix。
# Droidspaces 的 --x11 会以 termux 用户拉起 app_process，在 dagu 上直接重启设备，
# 因此容器改用 -B 挂载整个 Termux tmp 目录，由本脚本补上 X11 客户端要看的路径。
set -e

src=/mnt/termux/.X11-unix
dst=/tmp/.X11-unix

[ -d "$src" ] || exit 0
[ -n "$(ls -A "$src" 2>/dev/null)" ] || exit 0

mkdir -p "$dst"
if mountpoint -q "$dst"; then
    exit 0
fi

exec mount --bind "$src" "$dst"
