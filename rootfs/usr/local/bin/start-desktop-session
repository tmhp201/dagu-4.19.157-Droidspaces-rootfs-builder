#!/bin/sh
# Start the KDE session on the Termux:X11 display.
#
# Plasma 6 starts its components through the user systemd instance, which does
# not work inside this container: the units never report ready and are killed
# on their start timeout.  The session therefore runs on a private bus, the
# same way the reference container does.
set -eu

export DISPLAY="${DISPLAY:-:5}"
export QT_QPA_PLATFORM=xcb
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=KDE
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
unset WAYLAND_DISPLAY || true

if [ -S /tmp/.pulse-socket ] && [ -z "${PULSE_SERVER:-}" ]; then
    PULSE_SERVER="unix:/tmp/.pulse-socket"
    export PULSE_SERVER
fi

mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

exec dbus-run-session -- startplasma-x11
