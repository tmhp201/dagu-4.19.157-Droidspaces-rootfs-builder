# Dagu-Violin-KDE（Debian 13 / Xiaomi Pad 7S Pro）的构建默认值；环境变量优先于本文件。
# Plasma 6.7 需要 unstable 的 Qt 6.11（glibc >= 2.43），改用 trixie 则得到原生 6.3.6：
#   KDE_STACK=trixie ./build.sh -a aarch64 -i Dagu-Violin-KDE
KDE_STACK="${KDE_STACK:-unstable}"
DISPLAY_BACKEND="${DISPLAY_BACKEND:-x11}"
DESKTOP="${DESKTOP:-kde}"
DESKTOP_AUTOSTART="${DESKTOP_AUTOSTART:-true}"
PULSEAUDIO="${PULSEAUDIO:-socket}"
ENABLE_ZH_TZ="${ENABLE_ZH_TZ:-true}"
# kwin 的 OpenGL 合成器默认关闭；驱动稳定后可改成 true。
KDE_COMPOSITING="${KDE_COMPOSITING:-false}"
ENABLE_MESA="${ENABLE_MESA:-true}"
# systemd 257 钉版保留：unstable Plasma 6.7 栈的校验脚本（kde.sh
# debian_unstable_verify）强制运行时栈停在 trixie 版本，且 257 在
# 6.6.143 内核上运行正常——这是唯一未升到最新的组件（脚本硬约束）。
ENABLE_SYSTEMD257="${ENABLE_SYSTEMD257:-true}"
